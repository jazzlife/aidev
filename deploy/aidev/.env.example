AIDEV_PROXY_NETWORK=npm_bridge
AIDEV_SECRET_DIR=/home/turtlelab/aidev/secrets
CLAUDE_CODE_VERSION=2.1.276
SDB_TARBALL_URL=https://download.tizen.org/sdk/tizenstudio/official/binary/sdb_4.2.36_ubuntu-64.zip
SDB_SHA256=addf825e1a886a9f220cb3d287e74438cae0ffafe5821b9baca9d4f6c7de5124

# Laya decision service (deploy/aidev/laya). ROCm wheel index for the AI-PC (gfx1150 = ROCm 7.1+).
LAYA_TORCH_INDEX=https://download.pytorch.org/whl/rocm7.1
LAYA_MODEL=convaiinnovations/laya-multilingual
LAYA_DEVICE=auto
# gfx1150 (Radeon 890M) = 11.5.0. Never leave this empty: ROCm fails to enumerate the GPU on an empty value.
HSA_OVERRIDE_GFX_VERSION=11.5.0

# F-18: the gateway's Cloudflare-free address for runners and remote screens (docs/aidev/CONNECTIVITY.md, §5);
# empty: off. Needs the router's port forward, a DNS-only record and its certificate first.
AIDEV_REALTIME_ORIGIN=
