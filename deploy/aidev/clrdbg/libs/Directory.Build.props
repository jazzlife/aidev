<Project>
  <!-- CorApi / CorApi2 / Mono.Debugging.Win32 from debugger-libs (MIT), built for net472 (see ../build.sh) -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AutomaticallyUseReferenceAssemblyPackages Condition=" '$(FrameworkPathOverride)' != '' ">false</AutomaticallyUseReferenceAssemblyPackages>
    <DisableImplicitFrameworkReferences Condition=" '$(FrameworkPathOverride)' != '' ">true</DisableImplicitFrameworkReferences>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS0169;CS0649;CS0414;CS0108;CS0162;CS0168;CS0219;CS0067;CS1998;CS0659;CS0661;CS0660;CS8981;CS0114;CS0472;CS1717;CS0436</NoWarn>
    <OutputPath>$(ClrLibs)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="mscorlib" /><Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Xml" /><Reference Include="System.Data" /><Reference Include="Microsoft.CSharp" /><Reference Include="System.Xml.Linq" />
    <Reference Include="netstandard" Condition=" '$(FrameworkPathOverride)' != '' "><HintPath>$(FrameworkPathOverride)/Facades/netstandard.dll</HintPath></Reference>
    <Reference Include="System.Runtime" Condition=" '$(FrameworkPathOverride)' != '' "><HintPath>$(FrameworkPathOverride)/Facades/System.Runtime.dll</HintPath></Reference>
  </ItemGroup>
</Project>
